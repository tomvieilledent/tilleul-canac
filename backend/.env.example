# Copier en .env et remplir. Ne pas committer .env.
# Sur le VPS, ce fichier vit à /opt/vlldnt/config/tilleul-canac-api.env (hors Git, chmod 600) —
# c'est l'orchestrateur (deploy-project.sh) qui l'utilise via `docker compose --env-file`.
#
# Domaine : tilleul-canac-api.vlldnt.fr (niveau unique, couvert par le certificat
# wildcard *.vlldnt.fr mutualisé — jamais de sous-sous-domaine type api.<name>.vlldnt.fr).
DJANGO_SECRET_KEY=change-me-genere-une-cle-longue
DJANGO_DEBUG=false
ALLOWED_HOSTS=tilleul-canac-api.vlldnt.fr,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://tilleul-canac.vlldnt.fr,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://tilleul-canac-api.vlldnt.fr

DATABASE_URL=postgres://tdc:change-me@db:5432/tdc
POSTGRES_DB=tdc
POSTGRES_USER=tdc
POSTGRES_PASSWORD=change-me

# Extranet Booking : Tarifs & Disponibilité > Synchroniser les calendriers > Exporter
BOOKING_ICAL_URL=
# Phase 1 (validation manuelle, pas de paiement) : fenêtre large. Repasser à ~30 en phase 2 (Stripe).
BOOKING_HOLD_MINUTES=2880

# Port loopback exposé sur le VPS (doit correspondre à portfolio/projects.yml).
PORT=8083

# Données Postgres persistantes. Sur le VPS : /opt/vlldnt/data/tilleul-canac-api/pg.
# En local, laisser vide -> repli sur ./.pgdata (gitignored).
PGDATA_DIR=

# Phase 2 — Stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=
